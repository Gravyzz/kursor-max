# ─────────────────────────────────────────────────────────────────────────────
# Курсор — переменные окружения для СЕРВЕРА с настоящим MAX.
#   cp .env.production.example .env   # заполните значения ниже
#   docker compose up --build -d
#
# Что нужно заранее:
#   • VPS с публичным IP, открытые порты 80 и 443;
#   • домен, A-запись которого указывает на сервер (Caddy сам получит TLS-сертификат);
#   • бот MAX и его токен;
#   • в настройках бота на платформе для партнёров MAX — ссылка мини-приложения: https://<ваш домен>/
# Никогда не коммитьте заполненный .env.
# ─────────────────────────────────────────────────────────────────────────────

# Реестр базовых образов. Если Docker Hub недоступен (ошибки 403/429 при сборке),
# укажите зеркало: dockerhub.timeweb.cloud/library или mirror.gcr.io/library
IMAGE_REGISTRY=docker.io/library

# Подключает переопределения для продакшна (реальный Bot API, webhook, HTTPS, без имитации MAX).
COMPOSE_FILE=compose.yaml:compose.prod.yaml

NODE_ENV=production
DEV_AUTH=false
LOG_LEVEL=info

# Необязательно: отдельный ключ для автоматической проверки API жюри.
# Он открывает только модельную демо-песочницу. Сгенерируйте: openssl rand -hex 32
# Передайте значение проверяющим в закрытом архиве сдачи, но не коммитьте его в публичный репозиторий.
REVIEW_API_KEY=
REVIEW_USER_ID=9000000001

# Домен сервера (без https://) и публичный адрес мини-приложения.
SITE_ADDRESS=kursor.example.ru
PUBLIC_URL=https://kursor.example.ru

# MAX Bot API
MAX_API_BASE_URL=https://platform-api2.max.ru
# Токен бота: выдают организаторы хакатона (для своего бота — в его настройках на платформе для партнёров MAX).
BOT_TOKEN=
# webhook — рекомендуемый режим для продакшна; polling подходит для отладки без домена.
BOT_MODE=webhook
# Секрет подписки: 5–256 символов A-Z, a-z, 0-9, _ и -. Сгенерируйте: openssl rand -hex 32
WEBHOOK_SECRET=

# Секрет сервера: хеширование телефонов. Сгенерируйте: openssl rand -hex 32
# Смена секрета делает недействительными загруженные хеши телефонов (их нужно импортировать заново).
APP_SECRET=

# База данных. Пароль — только буквы и цифры (он входит в URL подключения): openssl rand -hex 24
POSTGRES_DB=spravochnik
POSTGRES_USER=spravochnik
POSTGRES_PASSWORD=

# Необязательно: имя (username) и id бота. Если пусто — берутся из GET /me при старте бота.
BOT_USERNAME=
BOT_USER_ID=
MINIAPP_BUTTON=open_app

# Демо с модельными данными можно оставить включённым для проверки жюри:
# песочница создаётся отдельно для каждого пользователя и не смешивается с данными вузов.
DEMO_ENABLED=true

# Часовой пояс вуза: сроки, напоминания и «сегодня» считаются в нём (имя вида Europe/Moscow, Asia/Tomsk).
APP_TIMEZONE=Europe/Moscow
# Сообщений в секунду из очереди уведомлений (лимит MAX Bot API — 30 запросов в секунду).
NOTIFY_RPS=20

# ── Тонкая настройка: значения по умолчанию подходят, менять не нужно ──
# Как часто worker проверяет очередь уведомлений, мс.
WORKER_TICK_MS=3000
# Запросов к API в минуту с одного IP. Студенты за NAT оператора делят лимит.
RATE_LIMIT_PER_MINUTE=600
# Сколько секунд действительны данные запуска мини-приложения (initData) из MAX.
INITDATA_MAX_AGE_SEC=86400
# Кому API верит в X-Forwarded-For. По умолчанию — соседнему прокси (Caddy в этом же compose):
# Caddy сам подставляет настоящий IP клиента. Менять нужно, только если API стоит за другим прокси.
# Если перед Caddy есть CDN, его подсеть нужно указать в trusted_proxies Caddy (apps/miniapp/Caddyfile),
# иначе ограничение частоты будет считать всех посетителей по одному IP.
TRUST_PROXY=loopback,linklocal,uniquelocal
