# ─────────────────────────────────────────────────────────────────────────────
# Курсор — переменные окружения для ЛОКАЛЬНОГО офлайн-стенда.
#   cp .env.example .env && docker compose up --build -d
#
# Без .env решение тоже запускается: в compose.yaml те же значения по умолчанию.
# Для сервера с настоящим MAX используйте .env.production.example.
# Файл .env не коммитится; здесь нет ни одного реального токена или пароля.
# ─────────────────────────────────────────────────────────────────────────────

# Реестр базовых образов. Если Docker Hub недоступен (ошибки 403/429 при сборке),
# укажите зеркало: dockerhub.timeweb.cloud/library или mirror.gcr.io/library
IMAGE_REGISTRY=docker.io/library

# Режим сервера. development нужен только для тестового входа DEV_AUTH.
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL в контейнере db. Порт базы наружу не публикуется.
POSTGRES_DB=spravochnik
POSTGRES_USER=spravochnik
POSTGRES_PASSWORD=spravochnik_local_only

# MAX Bot API. Локально — контейнер-имитация max-mock; токен-заглушка не является секретом.
MAX_API_BASE_URL=http://max-mock:9090
BOT_TOKEN=mock-token-not-a-secret
BOT_MODE=polling

# Адрес мини-приложения (Caddy). Локально — HTTP на порту 8080.
PUBLIC_URL=http://localhost:8080
SITE_ADDRESS=:8080

# Публикация портов на хосте (по умолчанию только для localhost).
WEB_BIND=127.0.0.1:8080
MOCK_BIND=127.0.0.1:9090
# Куда имитация чата MAX открывает мини-приложение.
MOCK_MINIAPP_URL=http://localhost:8080/

# Тестовый вход в мини-приложение без клиента MAX (?dev_user=<id>).
# Сервер откажется стартовать, если включить его при NODE_ENV=production.
DEV_AUTH=true

# Служебный доступ к API для проверки жюри. Локально не нужен.
REVIEW_API_KEY=
REVIEW_USER_ID=9000000001

# Демо-режим: личная «песочница» с модельными данными для каждого пользователя.
DEMO_ENABLED=true

# Часовой пояс вуза: сроки, напоминания и «сегодня» считаются в нём.
APP_TIMEZONE=Europe/Moscow

# Темп рассылки уведомлений, сообщений в секунду (лимит MAX Bot API — 30 запросов в секунду).
NOTIFY_RPS=20

# Необязательно: имя и id бота. Если пусто — берутся из GET /me.
BOT_USERNAME=
BOT_USER_ID=

# Кнопка открытия мини-приложения: open_app (рекомендуется) или link (диплинк ?startapp=).
MINIAPP_BUTTON=open_app

# Секрет сервера (не короче 16 символов): из него выводится ключ хеширования телефонов.
# Локально можно оставить пустым — будет использован ключ только для разработки.
APP_SECRET=

# Секрет подписки webhook. В режиме polling не используется.
WEBHOOK_SECRET=

# ── Тонкая настройка: значения по умолчанию подходят, менять не нужно ──
# Как часто worker проверяет очередь уведомлений, мс.
WORKER_TICK_MS=3000
# Запросов к API в минуту с одного IP.
RATE_LIMIT_PER_MINUTE=600
# Сколько секунд действительны данные запуска мини-приложения (initData) из MAX.
INITDATA_MAX_AGE_SEC=86400
# Кому API верит в X-Forwarded-For: соседнему прокси (Caddy в этом же compose).
TRUST_PROXY=loopback,linklocal,uniquelocal
